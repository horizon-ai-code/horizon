FROM python:3.10-slim AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc g++ make cmake && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY requirements.txt pyproject.toml ./

RUN pip install --no-cache-dir llama-cpp-python
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir pytest pytest-asyncio pytest-cov ruff mypy

FROM python:3.10-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends libgomp1 git curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin/pytest /usr/local/bin/ruff /usr/local/bin/mypy /usr/local/bin/

COPY app/ ./app/
COPY model_config.yaml prompts.yaml pyproject.toml ./
COPY scripts/ ./scripts/
COPY models/ /app/models/

RUN mkdir -p /app/db

EXPOSE 8000

CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
